# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key — https://console.groq.com/
GROQ_API_KEY=

# Database connection string
# SQLite (local dev):
# DATABASE_URL=sqlite:///./app.db
# PostgreSQL (production):
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DOCKER-POSTGRES:
POSTGRES_PASSWORD=password
# Test database connection string (used by pytest):
TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/myapp_test


# ── LLM ───────────────────────────────────────────────────────────────────────

# Model name passed to Groq
GROQ_MODEL=openai/gpt-oss-120b

# ── App ───────────────────────────────────────────────────────────────────────

# Enable debug logging and auto-reload
DEBUG=false

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Projects ──────────────────────────────────────────────────────────────────

# Where agent-generated project files are saved on disk
PROJECTS_BASE=./MY_PROJECTS

# ── Agent ─────────────────────────────────────────────────────────────────────

# Default and maximum LangGraph recursion limits
DEFAULT_RECURSION_LIMIT=100
MAX_RECURSION_LIMIT=200

# Maximum back-off (in seconds) when retrying on Groq rate-limit errors
MIN_DELAY_SECONDS=120


