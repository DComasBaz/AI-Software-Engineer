# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.npm/

# ── Build output (rebuilt inside Docker) ─────────────────────────────────────
dist/
build/

# ── Environment files (secrets must never enter the image) ───────────────────
.env
.env.*
!.env.example

# ── Editor & OS noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Logs & coverage ───────────────────────────────────────────────────────────
*.log
npm-debug.log*
coverage/
.nyc_output/

# ── Docker files (no need to copy these into their own build context) ─────────
Dockerfile
.dockerignore
